# Lumina AI configuration. Copy to .env and fill in. .env is gitignored.

ENVIRONMENT=development
LOG_LEVEL=INFO

# The tutor endpoint calls paid models on every request.
API_KEY=changeme-in-production
# Comma-separated browser origins. The app serves its own page, so this is
# only needed for a page hosted elsewhere. Never a wildcard.
CORS_ALLOW_ORIGINS=http://localhost:8000

# One provider is enough; OpenAI is preferred when both are set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Storage.
DB_PATH=tutor.db
CHROMA_PATH=chroma_db

MAX_TASK_CHARS=2000
LLM_TIMEOUT_SECONDS=60
